{
	"fileversion":"21.0.729",
	"name":"tethers",
	"categories":"Standard",
	"label":"Tethers",
	"type":"submenu",
	"pane": "network",
	"items":{
		"0":{
			"label":"Tether to Leader",
			"type":"script_action",
			"icon":"BUTTONS_link",
			"script":"import tethers.tools\ntethers.tools.link_selected(kwargs)"
		},
		"7":{
			"label":"Show All",
			"type":"script_action",
			"icon":"SCENEGRAPH_visible_on",
			"check":"import tethers.editor\nreturn tethers.editor.current_mode() == 'all'",
			"script":"import tethers.tools\ntethers.tools.set_display('all')"
		},
		"6":{
			"label":"Show Selected",
			"type":"script_action",
			"icon":"BUTTONS_visible",
			"check":"import tethers.editor\nreturn tethers.editor.current_mode() == 'selected'",
			"script":"import tethers.tools\ntethers.tools.set_display('selected')"
		},
		"5":{
			"label":"Hide Tethers",
			"type":"script_action",
			"icon":"SCENEGRAPH_visible_off",
			"check":"import tethers.editor\nreturn tethers.editor.current_mode() == 'off'",
			"script":"import tethers.tools\ntethers.tools.set_display('off')"
		},
		"4":{
			"label":"Untether",
			"type":"script_action",
			"icon":"BUTTONS_disconnect",
			"script":"import tethers.tools\ntethers.tools.unlink_selected(kwargs)"
		},
		"2":{
			"label":"Select Tethered",
			"type":"script_action",
			"icon":"BUTTONS_selectable_on",
			"script":"import tethers.tools\ntethers.tools.select_linked(kwargs)"
		}
	}
}
